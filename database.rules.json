{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "groups": { "$groupId": { ".validate": "newData.isBoolean()" } }
      }
    },
    "groups": {
      "$groupId": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && (!data.exists() || data.child('members').child(auth.uid).exists())",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "inviteCode": { ".validate": "newData.isString() && newData.val().length === 6" },
        "members": {
          "$uid": {
            ".validate": "newData.hasChildren(['name'])",
            "name": { ".validate": "newData.isString() && newData.val().length <= 40" }
          }
        },
        "expenses": {
          "$expenseId": {
            ".validate": "newData.hasChildren(['description', 'amount', 'paidBy', 'split', 'createdBy', 'createdAt'])",
            "amount": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100000000 && newData.val() % 1 === 0" },
            "paidBy": { ".validate": "root.child('groups').child($groupId).child('members').child(newData.val()).exists()" },
            "createdBy": { ".validate": "newData.val() === auth.uid" },
            "description": { ".validate": "newData.isString() && newData.val().length <= 80" }
          }
        },
        "payments": {
          "$paymentId": {
            ".validate": "newData.hasChildren(['from', 'to', 'amount', 'createdAt']) && newData.child('from').val() !== newData.child('to').val()",
            "amount": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() % 1 === 0" }
          }
        }
      }
    },
    "invites": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()"
      }
    }
  }
}
